# =========================================================
# Telegram Chat Summarizer Bot - Environment Configuration
# =========================================================

# 1. Token Bot Telegram (Didapat dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=

# 1b. Credentials Telegram Client API (Untuk Meringkas Grup Tanpa Perlu Undang Bot ke Grup)
# Dapatkan gratis di https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Token Opsional untuk Multi-Bot Simulator (Dipisahkan koma jika punya beberapa bot)
# SIMULATOR_BOT_TOKENS=12345:TOKEN1,67890:TOKEN2,11223:TOKEN3

# 2. Pilihan Provider AI: "gemini" (GRATIS), "openai" (GPT-4o/mini), "anthropic" (Claude), atau "hermes" (Nous-Hermes via OpenRouter/Ollama)
AI_PROVIDER=gemini

# ---------------------------------------------------------
# Opsi 1: Google Gemini API (100% GRATIS)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey (Login akun Google biasa)
# ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------
# Opsi 2: OpenAI GPT (Berbayar / Platform OpenAI API)
# Dapatkan di: https://platform.openai.com/api-keys
# ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------
# Opsi 2: Anthropic Claude (Berbayar / Trial)
# Dapatkan di: https://console.anthropic.com/
# ---------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------
# Opsi 3: Hermes AI / OpenRouter (Nous-Hermes 3 - Tanpa perlu melatih model)
# Dapatkan API Key di: https://openrouter.ai/keys (atau pakai Ollama lokal)
# ---------------------------------------------------------
HERMES_API_KEY=
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-8b:free
HERMES_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------
# Pengaturan Tambahan
# ---------------------------------------------------------
# Default rentang waktu (dalam jam) jika bot belum pernah membuat ringkasan
DEFAULT_SUMMARY_HOURS=24

# Path file database SQLite lokal
DATABASE_PATH=chat_history.db

# Maksimal pesan per batch untuk diproses AI
MAX_MESSAGES_PER_CHUNK=150
MAX_USERBOT_MESSAGES=300
